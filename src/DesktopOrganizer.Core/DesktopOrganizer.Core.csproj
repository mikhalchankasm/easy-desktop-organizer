<Project Sdk="Microsoft.NET.Sdk">

  <!-- Чистая логика восстановления без Win32/WPF: net8.0 (не -windows), чтобы тесты
       никогда не собирали и не блокировали запущенный DesktopOrganizer.exe. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Включаем анализаторы Roslyn и трактуем предупреждения как ошибки: чистое ядро
         логики восстановления не должно регрессировать (CI на каждой сборке/PR). -->
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
